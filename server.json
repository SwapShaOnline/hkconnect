  "repository": {
    "url": "https://github.com/SwapShaOnline/hkconnect",
    "source": "github"
  },
  "version": "0.1.3",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "hkc-mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "stdio"
        }
      ]
    }
  ]
}
